{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/equipment-set-spec.schema.json",
  "title": "Forge Equipment Set V1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "collection", "items", "license"],
  "properties": {
    "schemaVersion": { "const": "1" }, "kind": { "const": "equipment_set" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }, "name": { "type": "string", "minLength": 1 },
    "collection": { "type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": { "id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } },
    "items": { "type": "array", "minItems": 1, "maxItems": 21, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "prompt"], "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }, "name": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 },
      "referenceImage": { "type": "string" }, "equippedPreview": { "type": "boolean", "default": false }
    } } },
    "license": { "type": "string", "minLength": 1 }
  }
}
