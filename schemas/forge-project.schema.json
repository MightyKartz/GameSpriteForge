{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/forge-project.schema.json",
  "title": "Forge Project V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "provider", "outputDir"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profileId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 }
      }
    },
    "outputDir": { "type": "string", "minLength": 1 },
    "currentStyleRevision": { "type": "string", "minLength": 1 },
    "currentEnvironmentRevision": { "type": "string", "minLength": 1 }
  }
}
