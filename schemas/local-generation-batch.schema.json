{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MightyKartz/GameSpriteForge/schemas/local-generation-batch.schema.json",
  "title": "Forge local generation batch budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requests", "maxRequests", "maxTotalWaitSeconds", "maxTotalOutputBytes"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "requests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maxRequests": {"type": "integer", "minimum": 1, "maximum": 32},
    "maxTotalWaitSeconds": {"type": "integer", "minimum": 1},
    "maxTotalOutputBytes": {"type": "integer", "minimum": 1}
  }
}
