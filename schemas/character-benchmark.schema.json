{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamespriteforge.dev/schemas/character-benchmark-v1.json",
  "title": "Forge Character Benchmark V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "styles", "cases"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "spec"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "spec": { "$ref": "style-spec.schema.json" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "styleId", "subject"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "styleId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "subject": { "$ref": "subject-spec.schema.json" },
          "expectedHardDefect": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
