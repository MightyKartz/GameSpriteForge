{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/asset-requirements.schema.json",
  "title": "Forge Asset Requirements V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "asset_requirements"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "reviewDomain": {
            "enum": [
              "technical",
              "visual",
              "auditory",
              "license"
            ]
          },
          "reviewVerdict": {
            "enum": [
              "approved",
              "rejected",
              "needs_review",
              "unknown"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "reviewDomain"
              ]
            },
            "then": {
              "required": [
                "reviewVerdict"
              ]
            }
          },
          {
            "if": {
              "required": [
                "reviewVerdict"
              ]
            },
            "then": {
              "required": [
                "reviewDomain"
              ]
            }
          }
        ]
      }
    }
  }
}
