{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/decal-set-spec.schema.json",
  "title": "Forge Decal Set V1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "collection", "items", "license"],
  "properties": {
    "schemaVersion": { "const": "1" }, "kind": { "const": "decal_set" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }, "name": { "type": "string", "minLength": 1 },
    "collection": { "type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": { "id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } },
    "items": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "prompt", "footprint"], "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }, "name": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 }, "referenceImage": { "type": "string" },
      "footprint": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 32 }, "height": { "type": "integer", "minimum": 1, "maximum": 32 } } },
      "blend": { "enum": ["mix", "multiply", "add"], "default": "mix" }
    } } },
    "license": { "type": "string", "minLength": 1 }
  }
}
