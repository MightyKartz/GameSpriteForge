{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/portrait-set-spec.schema.json",
  "title": "Forge Portrait Set V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "collection", "subject", "expressions", "license"],
  "properties": {
    "schemaVersion": { "const": "1" }, "kind": { "const": "portrait_set" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }, "name": { "type": "string", "minLength": 1 },
    "collection": { "$ref": "#/$defs/revision" }, "subject": { "$ref": "#/$defs/revision" },
    "expressions": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "prompt"], "properties": {
        "id": { "enum": ["neutral", "happy", "angry", "hurt", "surprised"] }, "name": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }, "referenceImage": { "type": "string" }
      } }
    },
    "license": { "type": "string", "minLength": 1 }
  },
  "$defs": { "revision": { "type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": { "id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } } }
}
