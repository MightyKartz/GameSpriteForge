{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge Godot project toolchain requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "forgeVersion", "godotVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "forgeVersion": {"type": "string", "minLength": 1},
    "godotVersion": {"type": "string", "pattern": "^4\\.[67]\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$", "not": {"pattern": "[\\r\\n]"}}
  }
}
