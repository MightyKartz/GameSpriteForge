{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/map-spec.schema.json",
  "title": "Forge Map Spec V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "seed",
    "size",
    "dependencies",
    "regions",
    "connections",
    "landmarks",
    "requirements",
    "license"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "map" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 32, "maximum": 256 },
        "height": { "type": "integer", "minimum": 32, "maximum": 256 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrainSets", "buildingKits", "propSets"],
      "properties": {
        "terrainSets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packPath" } },
        "buildingKits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packPath" } },
        "propSets": { "type": "array", "items": { "$ref": "#/$defs/packPath" } }
      }
    },
    "regions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["spawn", "settlement", "forest", "water", "landmark", "exit"] },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "region"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "kind": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachableExit", "buildingCount", "propDensity"],
      "properties": {
        "reachableExit": { "type": "boolean" },
        "buildingCount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "propDensity": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "license": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "packPath": {
      "type": "string",
      "minLength": 9,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+\\.gsfpack$"
    }
  }
}
