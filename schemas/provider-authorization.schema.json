{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/provider-authorization.schema.json",
  "title": "Forge Provider Authorization Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "providerId",
    "profileId",
    "createdAt",
    "expiresAt",
    "maxTotalRequests",
    "maxTotalCostTicks",
    "allowedTargets"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "authorizationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "providerId": { "type": "string", "minLength": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "allowedModels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxTotalRequests": { "type": "integer", "minimum": 1 },
    "maxTotalProviderOperations": { "type": "integer", "minimum": 1 },
    "maxTotalCostTicks": { "type": "integer", "minimum": 1 },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "maxRequests", "costReservationTicksPerRequest"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "maxRequests": { "type": "integer", "minimum": 1 },
          "costReservationTicksPerRequest": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sourceLineageRootJobId": { "type": "string", "minLength": 1 },
    "recipeHash": { "type": "string", "minLength": 1 },
    "inputFingerprint": { "type": "string", "minLength": 1 }
  }
}
