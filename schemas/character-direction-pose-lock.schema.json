{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/character-direction-pose-lock.schema.json",
  "title": "Forge Direction Pose Lock V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "workflow", "providerId", "profileId", "model", "styleRevision", "subjectId", "subjectRevision", "subjectSha256", "equipmentKind", "entries"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "direction-pose-lock@1.0.0" },
    "workflow": { "const": "topdown-direction-poses@7.0.0" },
    "providerId": { "type": "string", "minLength": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "styleRevision": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "subjectRevision": { "type": "string", "minLength": 1 },
    "subjectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "equipmentKind": { "enum": ["none", "staff_like"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["animation", "direction", "attempt", "path", "sha256", "directionAnchorSha256", "assessment", "verdict", "reasons"],
        "properties": {
          "animation": { "enum": ["walk_up", "walk_right", "walk_down"] },
          "direction": { "enum": ["front", "rear", "right"] },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "generationMasterPath": { "type": "string", "minLength": 1 },
          "generationMasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "directionAnchorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "assessment": { "type": "object" },
          "verdict": { "enum": ["game_ready", "awaiting_review", "regenerate", "blocked"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
