{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/gsfpack.schema.json",
  "title": "Game Sprite Forge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "createdAt",
    "creator",
    "license",
    "source",
    "assets",
    "previews"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "2.0.0", "3.0.0"] },
    "assetType": {
      "enum": [
        "animation",
        "character",
        "icon_set",
        "prop_set",
        "terrain_set",
        "building_kit",
        "map"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "import_video",
            "import_frames",
            "import_sprite_sheet",
            "import_gsfpack",
            "provider_generation",
            "deterministic_compiler"
          ]
        },
        "name": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/animation" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "qualityReport"],
      "properties": {
        "frames": { "type": "string", "minLength": 1 },
        "spriteSheet": { "type": "string", "minLength": 1 },
        "atlas": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "godotHelper": { "type": "string", "minLength": 1 },
        "qualityReport": { "type": "string", "minLength": 1 },
        "consistencyReport": { "type": "string", "minLength": 1 },
        "terrainManifest": { "type": "string", "minLength": 1 },
        "buildingManifest": { "type": "string", "minLength": 1 },
        "mapManifest": { "type": "string", "minLength": 1 },
        "mapLayout": { "type": "string", "minLength": 1 },
        "validationReport": { "type": "string", "minLength": 1 },
        "atlasImage": { "type": "string", "minLength": 1 }
      }
    },
    "previews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gif": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["gif"] }, { "required": ["image"] }]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "frame", "texture"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "frame": { "type": "integer", "minimum": 0 },
          "texture": { "type": "string", "minLength": 1 },
          "provenance": { "$ref": "#/$defs/itemProvenance" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assetType", "sha256", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "assetType": { "enum": ["terrain_set", "building_kit", "prop_set"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": ["1.0.0", "2.0.0"] } } },
      "then": {
        "required": ["animations"],
        "properties": {
          "previews": { "required": ["gif"] },
          "assets": { "required": ["frames", "spriteSheet", "atlas"] }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "3.0.0" } } },
      "then": {
        "required": ["assetType"],
        "properties": {
          "assetType": { "enum": ["terrain_set", "building_kit", "map"] },
          "previews": { "required": ["image"] },
          "assets": { "required": ["godotHelper"] }
        }
      }
    }
  ],
  "$defs": {
    "itemProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "styleRevision", "attempt", "sha256"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "styleRevision": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "frames"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" }
      }
    }
  }
}
