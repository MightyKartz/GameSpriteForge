{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MightyKartz/GameSpriteForge/schemas/asset-library-transfer.schema.json",
  "title": "Forge selected resource directory bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "exportedAt",
    "exporter",
    "sourceCatalogSha256",
    "payload",
    "selections",
    "consumerLockPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "projectId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "exporter": {},
    "sourceCatalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "files"
      ],
      "properties": {
        "algorithm": {
          "const": "forge-content-inventory-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "revision",
          "contentSha256",
          "mediaPath",
          "legacyPackSha256",
          "legacyHashStyle"
        ],
        "properties": {
          "assetId": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaPath": {
            "type": "string"
          },
          "legacyPackSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "legacyHashStyle": {
            "enum": [
              "posix",
              "windows",
              "posix_and_windows",
              null
            ]
          }
        }
      }
    },
    "consumerLockPath": {
      "enum": [
        null,
        ".forge/library/consumer-resources.lock.json"
      ]
    }
  }
}
