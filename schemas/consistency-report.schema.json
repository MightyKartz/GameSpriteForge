{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/consistency-report.schema.json",
  "title": "Forge Consistency Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "assetType", "styleRevision", "verdict", "items"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": {
      "enum": [
        "consistency@1.0.0",
        "consistency@1.0.1",
        "consistency@1.1.0",
        "consistency@1.2.0",
        "consistency@1.3.0"
      ]
    },
    "assetType": { "enum": ["character", "icon_set", "prop_set"] },
    "styleRevision": { "type": "string", "minLength": 1 },
    "styleBaselineProfile": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["game_ready", "awaiting_review", "regenerate", "blocked"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "attempt", "metrics", "verdict", "reasons"]
      }
    }
  }
}
