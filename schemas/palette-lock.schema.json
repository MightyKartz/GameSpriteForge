{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/palette-lock.schema.json",
  "title": "Forge Palette Lock V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "revision", "source", "maxColors", "algorithm", "colors", "sha256"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "palette-lock@1.0.0" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["style_board", "canonical_idle"] },
        "revision": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "maxColors": { "type": "integer", "minimum": 2, "maximum": 256 },
    "algorithm": { "const": "deterministic-weighted-rgb@1.0.0" },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rgb", "weight"],
        "properties": {
          "rgb": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 3,
            "maxItems": 3
          },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
