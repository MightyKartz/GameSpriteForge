{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MightyKartz/GameSpriteForge/schemas/asset-library-intake.schema.json",
  "title": "Forge explicit resource intake batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "issues": {
      "type": "array",
      "description": "Optional read-only scan observations; ignored when registering the editable batch."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "path",
        "kind",
        "expectedContent"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "audio",
            "animation",
            "pack",
            "file"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "sha256",
            "files"
          ],
          "properties": {
            "algorithm": {
              "const": "forge-content-inventory-v1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "newRevision": {
          "type": "boolean"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "purpose": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "parentRevisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
