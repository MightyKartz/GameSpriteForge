{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MightyKartz/GameSpriteForge/schemas/asset-library-object.schema.json",
  "title": "Immutable Forge asset record or content revision",
  "oneOf": [
    {
      "$ref": "#/$defs/asset"
    },
    {
      "$ref": "#/$defs/revision"
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "path"
      ],
      "properties": {
        "rootId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "project",
        "target",
        "installedAt",
        "evidence"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project": {
          "$ref": "#/$defs/location"
        },
        "target": {
          "type": "string"
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "enum": [
            "legacy_installation_assertion",
            "installation_transaction"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "kind",
        "tags",
        "selectedRevision",
        "buildRevision",
        "revisions",
        "locations",
        "specLocations",
        "installations"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "buildRevision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "locations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/location"
          }
        },
        "specLocations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/location"
          }
        },
        "installations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/install"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assetId",
        "content",
        "legacy",
        "parentRevisions",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "sha256",
                "files"
              ],
              "properties": {
                "algorithm": {
                  "const": "forge-content-inventory-v1"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy": {
          "type": [
            "object",
            "null"
          ],
          "description": "Existing V2 execution fields. Machine paths and installed projection are removed; locations live in the asset record."
        },
        "parentRevisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "source": {
          "type": "object"
        }
      }
    }
  }
}
