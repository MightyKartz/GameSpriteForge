{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge consumer resource-version lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "projectId": {
      "type": "string"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "contentSha256"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
