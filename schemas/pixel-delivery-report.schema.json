{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/pixel-delivery-report.schema.json",
  "title": "Forge Pixel Delivery Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "gridDetection", "alphaBinary", "paletteLocked", "colorCount", "inputSha256", "outputSha256"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "pixel-delivery@2.0.0" },
    "gridDetection": { "enum": ["detected", "fallback"] },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellWidth", "cellHeight", "offsetX", "offsetY", "score"],
      "properties": {
        "cellWidth": { "type": "integer", "minimum": 1 },
        "cellHeight": { "type": "integer", "minimum": 1 },
        "offsetX": { "type": "integer", "minimum": 0 },
        "offsetY": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0 }
      }
    },
    "fallbackReason": { "type": "string", "minLength": 1 },
    "alphaBinary": { "type": "boolean" },
    "paletteLocked": { "type": "boolean" },
    "paletteLockRevision": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "paletteLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "colorCount": { "type": "integer", "minimum": 0 },
    "maxColors": { "type": "integer", "minimum": 2, "maximum": 256 },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
