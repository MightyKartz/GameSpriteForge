{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamespriteforge.dev/schemas/character-anchor-stabilization-report.schema.json",
  "title": "Forge Character Anchor Stabilization Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profile", "workflow", "animation", "translationOnly",
    "targetBodyCenterX", "targetBodyBottomY", "maximumTranslationPx",
    "maximumClippedForegroundRatio", "maximumResidualCenterDriftPx",
    "maximumResidualFootDriftPx", "verdict", "reasons", "frames"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "character-anchor-stabilization@1.0.0" },
    "workflow": { "const": "topdown-cycle@10.1.0" },
    "animation": { "const": "walk_down" },
    "translationOnly": { "const": true },
    "targetBodyCenterX": { "type": "number", "minimum": 0 },
    "targetBodyBottomY": { "type": "number", "minimum": 0 },
    "maximumTranslationPx": { "type": "integer", "minimum": 0 },
    "maximumClippedForegroundRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "maximumResidualCenterDriftPx": { "type": "number", "minimum": 0 },
    "maximumResidualFootDriftPx": { "type": "number", "minimum": 0 },
    "verdict": { "enum": ["game_ready", "blocked"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "frames": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animation", "frameIndex", "canvasWidth", "canvasHeight",
        "inputBodyCenterX", "inputBodyBottomY", "translationX", "translationY",
        "outputBodyCenterX", "outputBodyBottomY", "clippedForegroundPixelCount",
        "clippedForegroundRatio"
      ],
      "properties": {
        "animation": { "const": "walk_down" },
        "frameIndex": { "type": "integer", "minimum": 0, "maximum": 11 },
        "canvasWidth": { "type": "integer", "minimum": 1 },
        "canvasHeight": { "type": "integer", "minimum": 1 },
        "inputBodyCenterX": { "type": "number", "minimum": 0 },
        "inputBodyBottomY": { "type": "number", "minimum": 0 },
        "translationX": { "type": "integer" },
        "translationY": { "type": "integer" },
        "outputBodyCenterX": { "type": "number", "minimum": 0 },
        "outputBodyBottomY": { "type": "number", "minimum": 0 },
        "clippedForegroundPixelCount": { "type": "integer", "minimum": 0 },
        "clippedForegroundRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
