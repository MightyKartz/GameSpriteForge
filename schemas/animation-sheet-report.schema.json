{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/animation-sheet-report.schema.json",
  "title": "Forge Animation Sheet Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profile", "animation", "attempt", "sheetPath", "sheetSha256",
    "width", "height", "columns", "rows", "cellWidth", "cellHeight", "cells", "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "animation-sheet@1.0.0" },
    "animation": { "enum": ["idle", "walk_up", "walk_right", "walk_down"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "sheetPath": { "type": "string", "minLength": 1 },
    "sheetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "width": { "type": "integer", "minimum": 128 },
    "height": { "type": "integer", "minimum": 128 },
    "columns": { "const": 2 },
    "rows": { "const": 2 },
    "cellWidth": { "type": "integer", "minimum": 64 },
    "cellHeight": { "type": "integer", "minimum": 64 },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frameIndex", "row", "column", "x", "y", "width", "height",
          "foregroundRatio", "touchesCellBoundary", "contentSha256"
        ],
        "properties": {
          "frameIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
          "row": { "type": "integer", "minimum": 0, "maximum": 1 },
          "column": { "type": "integer", "minimum": 0, "maximum": 1 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 64 },
          "height": { "type": "integer", "minimum": 64 },
          "foregroundRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "touchesCellBoundary": { "type": "boolean" },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "verdict": { "enum": ["game_ready", "regenerate", "blocked"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
