{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamespriteforge.dev/schemas/gait-laterality-report.schema.json",
  "title": "Forge Gait Laterality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "animation",
    "minimumContactSignal",
    "minimumOppositeDelta",
    "oppositeContactDelta",
    "oppositePassingDelta",
    "frames",
    "verdict",
    "reasons"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profile": { "const": "gait-laterality@1.0.0" },
    "animation": { "const": "walk_down" },
    "minimumContactSignal": { "type": "number", "minimum": 0, "maximum": 1 },
    "minimumOppositeDelta": { "type": "number", "minimum": 0, "maximum": 2 },
    "oppositeContactDelta": { "type": "number", "minimum": 0, "maximum": 2 },
    "oppositePassingDelta": { "type": "number", "minimum": 0, "maximum": 2 },
    "frames": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frameIndex",
          "expectedSide",
          "observedSide",
          "contactSignal",
          "confidence",
          "screenLeftBottomY",
          "screenRightBottomY",
          "screenLeftArea",
          "screenRightArea",
          "matchesExpected"
        ],
        "properties": {
          "frameIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
          "expectedSide": { "enum": ["left", "right"] },
          "observedSide": { "enum": ["left", "right", "ambiguous"] },
          "contactSignal": { "type": "number", "minimum": -1, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "screenLeftBottomY": { "type": "integer", "minimum": 0 },
          "screenRightBottomY": { "type": "integer", "minimum": 0 },
          "screenLeftArea": { "type": "integer", "minimum": 0 },
          "screenRightArea": { "type": "integer", "minimum": 0 },
          "matchesExpected": { "type": "boolean" }
        }
      }
    },
    "verdict": { "enum": ["game_ready", "blocked"] },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommendedRetryFrames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 3 }
    }
  }
}
