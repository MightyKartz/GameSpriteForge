{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge editable local intake batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "issues": {
      "type": "array"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "name",
          "kind",
          "path",
          "expectedContent"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "audio",
              "animation",
              "pack",
              "file"
            ]
          },
          "path": {
            "type": "string"
          },
          "expectedContent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "sha256",
              "files"
            ],
            "properties": {
              "algorithm": {
                "const": "forge-content-inventory-v1"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "newRevision": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
