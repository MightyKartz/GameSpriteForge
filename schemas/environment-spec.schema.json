{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-sprite-forge.local/schemas/environment-spec.schema.json",
  "title": "Forge Environment Spec V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "prompt", "tileSize", "license"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "perspective": { "const": "top_down" },
    "tileSize": { "enum": [16, 32] },
    "imageModel": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 }
  }
}
