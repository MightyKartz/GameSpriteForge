    {
      "name": "walk", "fps": 10, "loop": true, "frameDurationsMs": [80, 120, 160],
      "input": {"kind": "png_sequence", "paths": ["../sources/walk-0.png", "../sources/walk-1.png", "../sources/walk-2.png"]},
      "matting": {"mode": "preserve_alpha"}
    },
    {
      "name": "attack", "fps": 10, "loop": false, "frameDurationsMs": [60, 240, 100],
      "input": {"kind": "png_sequence", "paths": ["../sources/attack-0.png", "../sources/attack-1.png", "../sources/attack-2.png"]},
      "matting": {"mode": "preserve_alpha"}
    }
  ]
